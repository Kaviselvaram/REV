# Copy to .env.local and fill in. Development should point at STAGING.
#
# The publishable key is designed to ship in a browser bundle — it carries no
# privileges of its own, and row-level security decides what the holder can
# actually read or write. The service-role key is the opposite: it bypasses
# RLS entirely. It must never appear in this file, in the frontend, or in git.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Dev-only SMS stub — see .env.local. Never set this in production.
VITE_DEV_AUTH=false
